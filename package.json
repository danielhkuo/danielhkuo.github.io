{
  "name": "danielhkuo.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contrast": "node scripts/check-contrast.mjs",
    "theme:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-theme.mjs",
    "a11y": "node scripts/run-axe.mjs",
    "doctor": "npx react-doctor@latest",
    "astryx": "astryx",
    "theme:build": "npm run astryx -- theme build src/theme/flexokiTheme.ts --out src/theme/theme.css",
    "favicons": "node scripts/recolor-favicon.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "test:minimal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/minimal-e2e.mjs",
    "world:render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-render.ts",
    "world:clouds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-clouds.ts",
    "world:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-live.ts",
    "world:dragon": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-dragon.ts",
    "world:wonders": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-wonders.ts",
    "world:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-build.ts",
    "world:map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-map.ts",
    "bench:cbonsai": "node scripts/bench-cbonsai.mjs",
    "goldens:cbonsai": "node scripts/cbonsai-goldens.mjs",
    "world:controls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/world-controls.ts",
    "test:mobile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/world-mobile.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@octokit/graphql": "^9.0.3",
    "lucide-react": "^1.18.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.11.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.65.1",
    "puppeteer": "^25.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wcag-contrast": "^3.0.0"
  }
